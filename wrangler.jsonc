{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orca-agent-poc",
  "main": "src/index.js",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "INSTANCE_SIZE": "standard-1",
    "POC_MONTHLY_RESERVATION_USD": "4"
  },
  "containers": [
    {
      "class_name": "AgentWorkspace",
      "scheduling_policy": "durable_object",
      "images": {
        // Image pipeline (see .github/workflows/container-image.yml + scripts/promote-image.sh):
        //   GitHub Actions (amd64) -> GHCR (source of truth) -> wrangler containers push -> Cloudflare managed registry.
        // durable_object cannot pull GHCR directly, so the named image must be a
        // digest-pinned Cloudflare managed-registry reference.
        "base": { "image": "registry.cloudflare.com/236e11ca7c49db525c48a5cd243dfb3d/orca-agent-poc-agentcloud@sha256:a3b7b8ec2c664c443407362bb2abdf6e38d523cea57fc859d03c86fcad64f4b0" }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AGENT_WORKSPACE", "class_name": "AgentWorkspace" }
    ]
  },
  "exports": {
    "AgentWorkspace": { "type": "durable-object", "storage": "sqlite" }
  }
}
